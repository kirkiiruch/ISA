# Порт веб-додатка на хості
APP_PORT=8000

# Налаштування MongoDB
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB_NAME=knowledge_base

# Налаштування Ollama
OLLAMA_URL=http://ollama:11434
LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text

# Налаштування RAG
CHUNK_SIZE=500
CHUNK_OVERLAP=50
TOP_K=3
SCORE_THRESHOLD=0.5
MAX_FILE_SIZE_MB=10